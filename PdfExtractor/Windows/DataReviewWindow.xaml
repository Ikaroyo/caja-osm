<Window x:Class="PdfExtractor.Windows.DataReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar Datos Extraídos" Height="750" Width="600" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="15">
        <StackPanel>
            <!-- Encabezado -->
            <Border Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                <TextBlock Text="📊 Revise y corrija los datos extraídos" FontWeight="Bold" FontSize="16" 
                           Foreground="#2E7D32" HorizontalAlignment="Center"/>
            </Border>
            
            <!-- Campos de datos -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Día y Fecha:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBox x:Name="txtDia" Text="{Binding Dia}" Width="50" Height="25" Margin="0,0,10,0"/>
                    <DatePicker x:Name="dpFecha" SelectedDate="{Binding Fecha}" Height="25"/>
                </StackPanel>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Lote:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBox x:Name="txtLote" Text="{Binding Lote}" Width="150" Height="25"/>
                    <TextBlock Text="Usuario:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                    <TextBox x:Name="txtUsuario" Text="{Binding Usuario}" Width="150" Height="25"/>
                </StackPanel>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="OSM:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtOSM" Text="{Binding OSM}" Margin="5,0,0,0" Height="25"/>
                
                <TextBlock Grid.Row="3" Grid.Column="0" Text="MUNI:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBox x:Name="txtMUNI" Text="{Binding MUNI}" Width="150" Height="25"/>
                    <TextBlock Text="Recibos:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBox x:Name="txtRecibosMuni" Text="{Binding TotalRecibosMuni}" Width="60" Height="25" IsReadOnly="True" Background="LightGray"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Crédito:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtCredito" Text="{Binding Credito}" Margin="5,0,0,0" Height="25"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Débito:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtDebito" Text="{Binding Debito}" Margin="5,0,0,0" Height="25"/>
                
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Créd + Déb:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtCreditoDebito" Text="{Binding CreditoDebitoFormatted, Mode=OneWay}" Margin="5,0,0,0" Height="25" IsReadOnly="True" Background="LightYellow"/>
                
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Cheque:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                    <TextBox x:Name="txtCheque" Text="{Binding Cheque}" Width="150" Height="25" KeyUp="TxtCheque_KeyUp"/>
                    <CheckBox Visibility="Hidden" x:Name="chkIngresarCheque" Content="Ingresar manualmente" VerticalAlignment="Center" Margin="10,0,0,0" Checked="ChkIngresarCheque_Checked"/>
                </StackPanel>
                
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Efectivo:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtEfectivo" Text="{Binding EfectivoFormatted, Mode=OneWay}" Margin="5,0,0,0" Height="25" IsReadOnly="True" Background="LightGray"/>
            </Grid>
            
            <!-- Observaciones -->
            <GroupBox Header="Observaciones" Margin="0,0,0,15" Height="100">
                <TextBox x:Name="txtObservaciones" Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                         Margin="5" Background="White"/>
            </GroupBox>
            
            <!-- Selección de caja -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Caja:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                <ComboBox x:Name="cmbCajaSelection" Width="120" Height="25" FontSize="12" SelectionChanged="CmbCaja_SelectionChanged">
                    <ComboBoxItem Content="CAJA 1" Tag="CAJA 1"/>
                    <ComboBoxItem Content="CAJA 2" Tag="CAJA 2"/>
                </ComboBox>
                <TextBlock Text="(se recordará para próximos lotes)" FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="10"/>
            </StackPanel>
            
            <!-- Texto informativo -->
            <TextBlock Text="* El efectivo se calcula automáticamente: OSM - Crédito - Débito - Cheque" 
                       FontStyle="Italic" Foreground="Gray" Margin="0,0,0,15"/>
            
            <!-- Botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Botones de impresión -->
                <Button x:Name="btnImprimirLote" Content="📄 Lote" Width="70" Height="30" Margin="0,0,5,0" 
                        Background="#E3F2FD" BorderBrush="#2196F3" Foreground="#1976D2" FontSize="11" 
                        ToolTip="Imprimir información del lote"/>
                <Button x:Name="btnImprimirCaratula" Content="📋 Carátula" Width="80" Height="30" Margin="0,0,5,0" 
                        Background="#F3E5F5" BorderBrush="#9C27B0" Foreground="#7B1FA2" FontSize="11" 
                        ToolTip="Imprimir carátula del lote"/>
                <Button x:Name="btnImprimirCheques" Content="💳 Cheques" Width="80" Height="30" Margin="0,0,15,0" 
                        Background="#E8F5E8" BorderBrush="#4CAF50" Foreground="#388E3C" FontSize="11" 
                        ToolTip="Imprimir información de cheques"/>
                
                <!-- Botones principales -->
                <Button x:Name="btnGuardar" Content="💾 Guardar" Width="100" Height="30" Click="BtnGuardar_Click" Margin="0,0,10,0" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="12"/>
                <Button x:Name="btnCancelar" Content="❌ Cancelar" Width="100" Height="30" Click="BtnCancelar_Click" 
                        Background="#F44336" Foreground="White" FontWeight="Bold" FontSize="12"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
